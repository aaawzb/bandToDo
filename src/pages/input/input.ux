<script>
  import router from '@system.router'
  import file from '@system.file'
  import prompt from '@system.prompt'
  import { getPriorityColor, getThemeColors, DATA_PATH } from '../../common/utils.js'
  import { broadcastChanged } from '../../common/sync.js'

  export default {
    private: {
      time: '',
      textValue: '',
      hide: true,
      keyboardtype: 'QWERTY',
      screentype: 'rect',
      selectedPriority: '无',
      selectedDate: '',
      priorityOptions: ['无', '低', '中', '高'],
      priorityIndex: 0,
      kbVisible: false,
      selectedColor: '#3184d0',
      themeColors: [],
      // 键盘状态
      pinyin: '',
      candidates: [],
      lang: 'cn',
      upperCase: false,
    },
    computed: {
      priorityLabel() {
        return this.selectedPriority
      },
      dateLabel() {
        if (this.selectedDate) {
          let parts = this.selectedDate.split('-')
          return (parts[1] || '') + '/' + (parts[2] || '')
        }
        return '日期'
      },
      inputTextColor() {
        return this.textValue ? 'white' : '#6f6f6f'
      },
      langLabel() {
        if (this.lang === 'cn') return '中/英'
        if (this.lang === 'en') return 'EN'
        return '123'
      }
    },
    onInit() {
      this.screentype = global.screenShape || 'rect'
      this.themeColors = getThemeColors()
    },
    onShow() {
      this.time = global.getTime ? global.getTime() : ''
      this.screentype = global.screenShape || 'rect'
      if (global.returnedDate) {
        this.selectedDate = global.returnedDate
        global.returnedDate = ''
      }
      if (global.returnedPriority) {
        let idx = this.priorityOptions.indexOf(global.returnedPriority)
        if (idx >= 0) {
          this.selectedPriority = global.returnedPriority
          this.priorityIndex = idx
        }
        global.returnedPriority = ''
      }
    },
    getPriorityColor(p) {
      return getPriorityColor(p)
    },
    onVisibilityChange(evt) {
      this.kbVisible = !evt.detail.visible
    },
    onDelete() {
      if (this.pinyin.length > 0) {
        this.pinyin = this.pinyin.slice(0, -1)
        this.updateCandidates()
      } else if (this.textValue.length > 0) {
        this.textValue = this.textValue.slice(0, -1)
      }
    },
    onComplete(evt) {
      this.textValue += evt.detail.content
    },
    changeKbState() {
      this.hide = !this.hide
    },
    hideKeyboard() {
      this.hide = true
      this.pinyin = ''
      this.candidates = []
    },
    onKey(key) {
      if (this.lang === 'cn') {
        this.pinyin += key.toLowerCase()
        this.updateCandidates()
      } else if (this.lang === 'en') {
        this.textValue += this.upperCase ? key : key.toLowerCase()
      } else {
        const numMap = {
          'Q': '1', 'W': '2', 'E': '3', 'R': '4', 'T': '5',
          'Y': '6', 'U': '7', 'I': '8', 'O': '9', 'P': '0',
          'A': '@', 'S': '#', 'D': '$', 'F': '%', 'G': '&',
          'H': '*', 'J': '(', 'K': ')', 'L': '-',
          'Z': '+', 'X': '=', 'C': '/', 'V': '?', 'B': '!',
          'N': '.', 'M': ','
        }
        this.textValue += numMap[key] || key
      }
    },
    selectCandidate(word) {
      this.textValue += word
      this.pinyin = ''
      this.candidates = []
    },
    onSpace() {
      if (this.pinyin.length > 0 && this.candidates.length > 0) {
        this.textValue += this.candidates[0]
        this.pinyin = ''
        this.candidates = []
      } else {
        this.textValue += ' '
        this.pinyin = ''
        this.candidates = []
      }
    },
    toggleLang() {
      if (this.lang === 'cn') this.lang = 'en'
      else if (this.lang === 'en') this.lang = 'num'
      else this.lang = 'cn'
    },
    updateCandidates() {
      const dict = {
        'ni': ['你', '尼', '泥', '拟'],
        'hao': ['好', '号', '豪', '耗'],
        'shi': ['是', '时', '事', '市', '世', '式', '试', '十', '实', '石'],
        'wo': ['我', '握', '卧', '窝'],
        'de': ['的', '得', '德'],
        'le': ['了', '乐', '勒'],
        'zai': ['在', '再', '载'],
        'you': ['有', '又', '友', '由', '游'],
        'ta': ['他', '她', '它'],
        'men': ['们', '门'],
        'da': ['大', '打', '达'],
        'xiao': ['小', '笑', '校', '消'],
        'zhong': ['中', '重', '种', '钟'],
        'guo': ['国', '过', '果'],
        'ren': ['人', '任', '认'],
        'lai': ['来', '赖'],
        'qu': ['去', '取', '区'],
        'dao': ['到', '道', '倒'],
