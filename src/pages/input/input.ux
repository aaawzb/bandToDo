        'jing': ['经', '京', '精', '睛'],
        'chang': ['长', '常', '场', '唱'],
        'gong': ['工', '公', '功', '共'],
        'he': ['和', '合', '何', '喝'],
        'ping': ['平', '评', '苹'],
        'an': ['安', '按'],
        'zhao': ['找', '照'],
        'rang': ['让'],
        'bei': ['被', '北', '备', '背'],
