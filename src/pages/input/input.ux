<template>
  <div class="container">
    <text class="time">{{ time }}</text>
    <text class="title" if="{{ global.screenShape == 'rect' }}">新建待办</text>
    <img
      if="{{ global.screenShape == 'rect' }}"
      class="top leftButton"
      src="/common/back_rect.png"
      @click="goBack"
    />
    <div @click="goBack" class="title circle-title" elif="{{ global.screenShape == 'circle' }}">
      <img class="icon-back" src="/common/back.png" />
      <text class="title-text">新建待办</text>
    </div>
    <img else class="top" src="/common/back.png" @click="goBack" />

    <img
      if="{{ global.screenShape == 'rect' }}"
      class="top rightButton"
      src="/common/check_rect.png"
      @click="saveTodo"
    />
    <img else class="bottom" src="/common/check.png" @click="saveTodo" />

    <div class="padding" style="height: {{kbVisible ? '320px' : '100px'}};"></div>

    <!-- 输入框（胶囊形） -->
    <div class="line">
      <div class="input-line capsule-input" @click="changeKbState">
        <text class="input-text" style="color: {{inputTextColor}};">
          {{textValue || '点击输入内容'}}
        </text>
      </div>
    </div>

    <!-- 操作栏 -->
    <div class="action-bar">
      <div class="action-btn priority-btn">
        <text class="action-label">优先级</text>
        <text class="priority-preview" style="color: {{getPriorityColor(selectedPriority)}};">{{priorityLabel}}</text>
      </div>
      <div class="action-btn date-btn" onclick="showDatePicker">
        <text class="action-label">日期</text>
        <text class="action-text">{{dateLabel}}</text>
      </div>
    </div>

    <!-- 主题色选择器 -->
    <div class="theme-section">
      <text class="theme-label">主题色</text>
      <div class="theme-colors">
        <div for="{{ themeColors }}" class="color-swatch" style="background-color: {{ $item.hex }}; opacity: {{ $item.hex === selectedColor ? 1.0 : 0.4 }};" onclick="selectColor($idx)"></div>
      </div>
    </div>

    <!-- 优先级滑动选择 -->
    <div class="priority-picker-container">
      <text class="section-label">优先级</text>
      <picker class="priority-picker" type="text" range="{{priorityOptions}}" selected="{{priorityIndex}}" @change="onPriorityChange" />
    </div>

    <import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>
    <input-method
      hide="{{hide}}"
      keyboardtype="{{keyboardtype}}"
      maxlength="6"
      vibratemode="short"
      screentype="{{screentype}}"
      @visibilitychange="onVisibilityChange"
      @keydown="onKeyDown"
      @delete="onDelete"
      @complete="onComplete"
    ></input-method>
  </div>
</template>

<style>
  @import '../../common/app.css';

  .container {
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    background-color: #000000;
    width: 100%;
    height: 100%;
  }

  .line {
    width: 90%;
    margin-bottom: 12px;
  }

  .capsule-input {
    height: 64px;
    width: 100%;
    background-color: #262626;
    border: 3px solid rgba(255, 255, 255, 0.06);
    border-radius: 32px;
    display: flex;
    align-items: center;
  }

  .input-text {
    width: 100%;
    font-size: 28px;
    color: white;
    font-weight: bold;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    height: 64px;
    padding: 0 24px;
    text-align: center;
  }

  .padding {
    height: 100px;
  }

  .action-bar {
    width: 90%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 8px;
  }

  .action-btn {
    padding: 10px 18px;
    background-color: #262626;
    border-radius: 16px;
    border: 3px solid rgba(255, 255, 255, 0.06);
    flex: 1;
    flex-direction: column;
    align-items: center;
  }

  .priority-btn {
    margin-right: 8px;
  }

  .date-btn {
    margin-left: 8px;
  }

  .action-label {
    font-size: 18px;
    color: #6f6f6f;
    margin-bottom: 4px;
  }

  .priority-preview {
    font-size: 22px;
    font-weight: bold;
  }

  .action-text {
    font-size: 22px;
    color: #6f6f6f;
  }

  .theme-section {
    width: 90%;
    margin-top: 16px;
    flex-direction: column;
    align-items: center;
  }

  .section-label {
    font-size: 20px;
    color: #6f6f6f;
    margin-bottom: 10px;
  }

  .theme-label {
    font-size: 20px;
    color: #6f6f6f;
    margin-bottom: 10px;
  }

  .theme-colors {
    flex-direction: row;
    justify-content: center;
    align-items: center;
  }

  .color-swatch {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    margin: 0 8px;
    border: 3px solid rgba(255, 255, 255, 0.15);
  }

  .priority-picker-container {
    width: 90%;
    margin-top: 16px;
    flex-direction: column;
    align-items: center;
  }

  .priority-picker {
    font-size: 36px;
    color: rgba(255, 255, 255, 0.3);
    selected-color: #ffffff;
    selected-font-size: 42px;
  }

  .icon-back {
    width: 28px;
    height: 28px;
    margin-right: 6px;
  }

  .circle-title {
    flex-direction: row;
    align-items: center;
  }

  .title-text {
    font-size: 32px;
    font-weight: bold;
    color: rgba(255, 255, 255, 1);
  }

  @media (device-type: band) and (shape: rect) {
    .line {
      width: 83%;
    }

    .action-bar {
      width: 83%;
    }

    .theme-section {
      width: 83%;
    }

    .padding {
      height: 90px;
    }

    .capsule-input {
      height: 56px;
      border-radius: 28px;
    }

    .input-text {
      font-size: 24px;
      height: 56px;
      padding: 0 20px;
      text-align: center;
    }

    .action-btn {
      padding: 8px 14px;
      border-radius: 14px;
    }

    .action-label {
      font-size: 16px;
    }

    .priority-preview,
    .action-text {
      font-size: 20px;
    }

    .color-swatch {
      width: 32px;
      height: 32px;
    }

    .priority-picker-container {
      width: 83%;
    }
  }

  @media (device-type: watch) and (shape: rect) {
    .line {
      width: 75%;
    }

    .action-bar {
      width: 75%;
    }

    .theme-section {
      width: 75%;
    }

    .padding {
      height: 110px;
    }

    .priority-picker-container {
      width: 75%;
    }
  }

  @media (device-type: watch) and (shape: circle) {
    .line {
      width: 70%;
    }

    .action-bar {
      width: 70%;
    }

    .theme-section {
      width: 70%;
    }

    .padding {
      height: 70px;
    }

    .capsule-input {
      height: 56px;
      border-radius: 28px;
    }

    .input-text {
      font-size: 24px;
      height: 56px;
      padding: 0 20px;
      text-align: center;
    }

    .action-btn {
      padding: 8px 12px;
      border-radius: 14px;
    }

    .action-label {
      font-size: 16px;
    }

    .priority-preview,
    .action-text {
      font-size: 20px;
    }

    .color-swatch {
      width: 32px;
      height: 32px;
    }

    .priority-picker-container {
      width: 70%;
    }
  }
</style>

<script>
  import router from '@system.router'
  import file from '@system.file'
  import prompt from '@system.prompt'
  import { getPriorityColor, getThemeColors, DATA_PATH } from '../../common/utils.js'
  import { broadcastChanged } from '../../common/sync.js'

  export default {
    private: {
      time: '',
      textValue: '',
      hide: true,
      keyboardtype: 'QWERTY',
      screentype: 'rect',
      selectedPriority: '无',
      selectedDate: '',
      priorityOptions: ['无', '低', '中', '高'],
      priorityIndex: 0,
      kbVisible: false,
      selectedColor: '#3184d0',
      themeColors: [],
    },
    computed: {
      priorityLabel() {
        return this.selectedPriority
      },
      dateLabel() {
        if (this.selectedDate) {
          let parts = this.selectedDate.split('-')
          return (parts[1] || '') + '/' + (parts[2] || '')
        }
        return '日期'
      },
      inputTextColor() {
        return this.textValue ? 'white' : '#6f6f6f'
      }
    },
    onInit() {
      this.screentype = global.screenShape || 'rect'
      this.themeColors = getThemeColors()
    },
    onShow() {
      this.time = global.getTime ? global.getTime() : ''
      if (global.returnedDate) {
        this.selectedDate = global.returnedDate
        global.returnedDate = ''
      }
    },
    getPriorityColor(p) {
      return getPriorityColor(p)
    },
    onVisibilityChange(evt) {
      this.kbVisible = evt.detail.visible
    },
    onKeyDown(evt) {},
    onDelete() {
      this.textValue = this.textValue.slice(0, -1)
    },
    onComplete(evt) {
      this.textValue += evt.detail.content
    },
    changeKbState() {
      this.hide = !this.hide
    },
    onPriorityChange(e) {
      this.priorityIndex = e.newSelected
      this.selectedPriority = this.priorityOptions[this.priorityIndex]
    },
    showDatePicker() {
      router.push({ uri: '/pages/datepicker' })
    },
    selectColor(idx) {
      this.selectedColor = this.themeColors[idx].hex
    },
    goBack() {
      router.back()
    },
    saveTodo() {
      let title = this.textValue.trim()
      if (!title) {
        prompt.showToast({ message: '请输入待办内容' })
        return
      }

      let todo = {
        title: title,
        done: false,
        priority: this.selectedPriority,
        dueDate: this.selectedDate || '',
        themeColor: this.selectedColor,
        createdAt: new Date().toISOString()
      }

      let that = this
      file.readText({
        uri: 'internal://app' + DATA_PATH,
        success(ret) {
          let todos = []
          try {
            let parsed = JSON.parse(ret.text)
            if (Array.isArray(parsed)) {
              todos = parsed
            }
          } catch (e) {}
          todos.push(todo)
          that.writeTodos(todos)
        },
        fail() {
          that.writeTodos([todo])
        }
      })
    },
    writeTodos(todos) {
      file.writeText({
        uri: 'internal://app' + DATA_PATH,
        text: JSON.stringify(todos),
        success() {
          broadcastChanged()
          router.back()
        },
        fail() {
          prompt.showToast({ message: '保存失败' })
        }
      })
    }
  }
</script>
