        'lv': ['绿'],
        'lan': ['蓝'],
        'huang': ['黄'],
        'zi3': ['紫'],
        'hui4b': ['灰'],
        'fen2': ['粉'],
        'cheng2': ['橙'],
        'zong': ['棕'],
        'qing2': ['青'],
        'xihuan': ['喜欢'],
        'gaoxing': ['高兴'],
        'kaixin': ['开心'],
        'shengqi': ['生气'],
        'nanguo': ['难过'],
        'haipa': ['害怕'],
        'jingya': ['惊讶'],
        'wuliao': ['无聊'],
        'yukuai': ['愉快'],
        'fennu': ['愤怒'],
        'beishang': ['悲伤'],
        'haochi': ['好吃'],
        'nanchi': ['难吃'],
        'haoting': ['好听'],
        'nanting': ['难听'],
        'haokan': ['好看'],
        'nankan': ['难看'],
        'rongyi': ['容易'],
        'kunnan': ['困难'],
        'zhongyao': ['重要'],
        'jiandan': ['简单'],
        'fuza': ['复杂'],
        'anquan': ['安全'],
        'weixian': ['危险'],
        'jiankang': ['健康'],
        'shengbing': ['生病'],
        'gongzuo': ['工作'],
        'xiuxi': ['休息'],
        'yundong': ['运动'],
        'dushu': ['读书'],
        'xiezi': ['写字'],
        'ting': ['听', '停'],
        'tiao': ['跳'],
        'pa': ['爬'],
        'hua4': ['画'],
        'wan2': ['玩'],
        'le4': ['了']
      }
      this.candidates = dict[this.pinyin] || []
    },
    goToPriority() {
      router.push({ uri: '/pages/priority' })
    },
    showDatePicker() {
      router.push({ uri: '/pages/datepicker' })
    },
    selectColor(idx) {
      this.selectedColor = this.themeColors[idx].hex
    },
    goBack() {
      router.back()
    },
    saveTodo() {
      let title = this.textValue.trim()

      let todo = {
        title: title,
        done: false,
        priority: this.selectedPriority,
        dueDate: this.selectedDate || '',
        themeColor: this.selectedColor,
        createdAt: new Date().toISOString()
      }

      let that = this
      file.readText({
        uri: 'internal://app' + DATA_PATH,
        success(ret) {
          let todos = []
          try {
            let parsed = JSON.parse(ret.text)
            if (Array.isArray(parsed)) {
              todos = parsed
            }
          } catch (e) {}
          todos.push(todo)
          that.writeTodos(todos)
        },
        fail() {
          that.writeTodos([todo])
        }
      })
    },
    writeTodos(todos) {
      file.writeText({
        uri: 'internal://app' + DATA_PATH,
        text: JSON.stringify(todos),
        success() {
          broadcastChanged()
          router.back()
        },
        fail() {
          prompt.showToast({ message: '保存失败' })
        }
      })
    }
  }
</script>
