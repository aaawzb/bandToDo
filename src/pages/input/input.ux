        'zhen': ['真', '镇'],
        'zheng': ['正', '整', '证'],
        'ying': ['应', '英', '影'],
        'gai': ['改', '该'],
        'she': ['社', '设'],
        'ji': ['机', '几', '及', '记', '计', '寄'],
        'zi': ['子', '自', '字'],
        'sheng': ['生', '声', '升', '胜'],
