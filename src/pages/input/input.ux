        'ye': ['也', '业', '夜'],
        'hen': ['很', '恨'],
        'xi': ['喜', '系', '西', '习', '细', '戏'],
        'guan': ['关', '管', '观'],
        'xin': ['新', '心', '信'],
        'zhe': ['这', '着'],
        'na': ['那', '哪', '拿'],
        'huo': ['或', '火', '活', '货'],
        'wei': ['为', '位', '未', '味'],
        'suo': ['所', '索', '锁'],
        'er': ['而', '儿', '二'],
        'san': ['三'],
        'si': ['四', '死', '思'],
        'wu': ['五', '物', '无', '务', '舞'],
        'liu': ['六', '流', '留'],
        'qi': ['七', '起', '气', '骑', '期'],
        'ba': ['八', '把', '爸'],
        'tian': ['天', '田', '甜', '填'],
        'di': ['地', '第', '弟', '低'],
        'chu': ['出', '初', '处', '除'],
        'jin': ['进', '近', '今', '金'],
        'xing': ['行', '星', '兴', '姓', '醒'],
        'fa': ['发', '法', '罚'],
        'cheng': ['成', '城', '程', '称'],
