<template>
  <div class="container">
    <text class="time">{{ time }}</text>
    <text class="title" if="{{ global.screenShape == 'rect' }}">新建待办</text>
    <img
      if="{{ global.screenShape == 'rect' }}"
      class="top leftButton"
      src="/common/back_rect.png"
      @click="goBack"
    />
    <text @click="goBack" class="title" elif="{{ global.screenShape == 'circle' }}">
      <span class="iconfont">&#xe685;</span>
      <span>新建待办</span>
    </text>
    <img else class="top" src="/common/back.png" @click="goBack" />

    <img
      if="{{ global.screenShape == 'rect' }}"
      class="top rightButton"
      src="/common/check_rect.png"
      @click="saveTodo"
    />
    <img else class="bottom" src="/common/check.png" @click="saveTodo" />

    <div class="padding"></div>
    <div class="line">
      <div class="input-line" @click="changeKbState">
        <text class="input-text" style="color: {{inputTextColor}};">
          {{textValue || '点击输入内容'}}
        </text>
      </div>
    </div>

    <div class="action-bar">
      <div class="action-btn priority-btn" onclick="showPriorityPicker">
        <text class="priority-preview" style="color: {{getPriorityColor(selectedPriority)}};">{{priorityLabel}}</text>
      </div>
      <div class="action-btn date-btn" onclick="showDatePicker">
        <text class="action-text">{{dateLabel}}</text>
      </div>
    </div>

    <div class="priority-picker" if="{{showPriority}}">
      <div class="picker-overlay" onclick="hidePriorityPicker"></div>
      <div class="picker-panel">
        <div class="picker-header">
          <text class="picker-cancel" onclick="hidePriorityPicker">取消</text>
          <text class="picker-title">优先级</text>
          <text class="picker-confirm" onclick="confirmPriority">确定</text>
        </div>
        <picker class="priority-wheel" type="text" range="{{priorityOptions}}" selected="{{priorityIndex}}" @change="onPriorityChange"></picker>
      </div>
    </div>

    <import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>
    <input-method
      hide="{{hide}}"
      keyboardtype="{{keyboardtype}}"
      maxlength="100"
      vibratemode="short"
      screentype="{{screentype}}"
      @visibilitychange="onVisibilityChange"
      @keydown="onKeyDown"
      @delete="onDelete"
      @complete="onComplete"
    ></input-method>
  </div>
</template>

<style>
  @import '../../common/app.css';

  .container {
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    background-color: #000000;
  }

  .line {
    width: 90%;
    margin-bottom: 12px;
  }

  .input-line {
    height: 64px;
    width: 100%;
    background-color: #262626;
    border: 3px solid rgba(255, 255, 255, 0.06);
    border-radius: 16px;
    display: flex;
    align-items: center;
  }

  .input-text {
    width: 100%;
    padding: 0 16px;
    font-size: 28px;
    color: white;
    font-weight: bold;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .placeholder-text {
    color: #6f6f6f;
  }

  .padding {
    height: 100px;
  }

  .action-bar {
    width: 90%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 8px;
  }

  .action-btn {
    padding: 10px 18px;
    background-color: #262626;
    border-radius: 16px;
    border: 3px solid rgba(255, 255, 255, 0.06);
    flex: 1;
  }

  .priority-btn {
    margin-right: 8px;
    text-align: left;
  }

  .date-btn {
    margin-left: 8px;
    text-align: right;
  }

  .priority-preview {
    font-size: 22px;
    color: white;
  }

  .action-text {
    font-size: 22px;
    color: #6f6f6f;
  }

  .priority-picker {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    justify-content: flex-end;
    z-index: 100;
  }

  .picker-overlay {
    flex: 1;
    background-color: rgba(0, 0, 0, 0.5);
  }

  .picker-panel {
    background-color: #1a1a1a;
    border-radius: 20px 20px 0 0;
    padding: 24px 20px;
    border: 3px solid rgba(255, 255, 255, 0.06);
    border-bottom: none;
  }

  .picker-title {
    font-size: 24px;
    color: #ffffff;
    text-align: center;
    flex: 1;
  }

  .picker-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
  }

  .picker-cancel,
  .picker-confirm {
    font-size: 24px;
    color: #4cd964;
    padding: 8px;
  }

  .priority-wheel {
    height: 200px;
    width: 100%;
    color: rgba(255, 255, 255, 0.3);
    font-size: 22px;
    selected-color: #ffffff;
    selected-font-size: 34px;
  }

  @media (device-type: band) and (shape: rect) {
    .line {
      width: 83%;
    }

    .action-bar {
      width: 83%;
    }

    .padding {
      height: 90px;
    }

    .input-line {
      height: 56px;
      border-radius: 14px;
    }

    .input-text {
      font-size: 24px;
      padding: 0 14px;
    }

    .action-btn {
      padding: 8px 14px;
      border-radius: 14px;
    }

    .priority-preview,
    .action-text {
      font-size: 20px;
    }

    .priority-wheel {
      selected-font-size: 30px;
    }

    .picker-title {
      font-size: 22px;
    }
  }

  @media (device-type: watch) and (shape: rect) {
    .line {
      width: 75%;
    }

    .action-bar {
      width: 75%;
    }

    .padding {
      height: 110px;
    }
  }

  @media (device-type: watch) and (shape: circle) {
    .line {
      width: 70%;
    }

    .action-bar {
      width: 70%;
    }

    .padding {
      height: 70px;
    }

    .input-line {
      height: 56px;
      border-radius: 14px;
    }

    .input-text {
      font-size: 24px;
    }

    .action-btn {
      padding: 8px 12px;
      border-radius: 14px;
    }

    .priority-preview,
    .action-text {
      font-size: 20px;
    }
  }
</style>

<script>
  import router from '@system.router'
  import file from '@system.file'
  import prompt from '@system.prompt'
  import { getPriorityColor } from '../../common/utils.js'

  const DATA_PATH = '/data/todos.json'

  export default {
    private: {
      time: '',
      textValue: '',
      hide: true,
      keyboardtype: 'QWERTY',
      screentype: 'rect',
      selectedPriority: '无',
      selectedDate: '',
      showPriority: false,
      priorityOptions: ['无', '低', '中', '高'],
      priorityIndex: 0,
    },
    computed: {
      priorityLabel() {
        return this.selectedPriority
      },
      dateLabel() {
        if (this.selectedDate) {
          let parts = this.selectedDate.split('-')
          return (parts[1] || '') + '/' + (parts[2] || '')
        }
        return '日期'
      },
      inputTextColor() {
        return this.textValue ? 'white' : '#6f6f6f'
      }
    },
    onInit() {
      this.screentype = global.screenShape || 'rect'
    },
    onShow() {
      this.time = global.getTime ? global.getTime() : ''
      if (global.returnedDate) {
        this.selectedDate = global.returnedDate
        global.returnedDate = ''
      }
    },
    getPriorityColor(p) {
      return getPriorityColor(p)
    },
    onVisibilityChange(evt) {
      console.log('键盘可见性变化:' + JSON.stringify(evt))
    },
    onKeyDown(evt) {
      console.log('按下按键:' + JSON.stringify(evt))
    },
    onDelete() {
      this.textValue = this.textValue.slice(0, -1)
    },
    onComplete(evt) {
      this.textValue += evt.detail.content
    },
    changeKbState() {
      this.hide = !this.hide
    },
    showPriorityPicker() {
      this.priorityIndex = this.priorityOptions.indexOf(this.selectedPriority)
      this.showPriority = true
    },
    hidePriorityPicker() {
      this.showPriority = false
    },
    onPriorityChange(evt) {
      this.priorityIndex = evt.newSelected
    },
    confirmPriority() {
      this.selectedPriority = this.priorityOptions[this.priorityIndex]
      this.showPriority = false
    },
    showDatePicker() {
      router.push({ uri: '/pages/datepicker' })
    },
    goBack() {
      router.back()
    },
    saveTodo() {
      let title = this.textValue.trim()
      if (!title) {
        prompt.showToast({ message: '请输入待办内容' })
        return
      }

      let todo = {
        title: title,
        done: false,
        priority: this.selectedPriority,
        dueDate: this.selectedDate || '',
        createdAt: new Date().toISOString()
      }

      let that = this
      file.readText({
        uri: 'internal://app' + DATA_PATH,
        success(ret) {
          let todos = []
          try {
            let parsed = JSON.parse(ret.text)
            if (Array.isArray(parsed)) {
              todos = parsed
            }
          } catch (e) {}
          todos.push(todo)
          that.writeTodos(todos)
        },
        fail() {
          that.writeTodos([todo])
        }
      })
    },
    writeTodos(todos) {
      file.writeText({
        uri: 'internal://app' + DATA_PATH,
        text: JSON.stringify(todos),
        success() {
          router.back()
        },
        fail() {
          prompt.showToast({ message: '保存失败' })
        }
      })
    }
  }
</script>