<template>
  <div class="index-page">
    <text class="time">{{ time }}</text>
    <text class="title">待办清单</text>

    <div class="box">
      <div if="{{ todos.length === 0 }}" class="empty-state">
        <text class="empty-text">暂无待办事项</text>
        <text class="empty-hint">点击下方按钮添加</text>
      </div>

          <div elif="{{ todos.length === 1 }}" class="single-wrapper">
            <div class="todo-card single-card" style="border-left: 6px solid {{singleTodo.themeColor || '#3184d0'}};" onclick="toggleDone(0)" onlongpress="deleteTodo(0)">
              <div class="card-main">
                <marquee class="todo-title" scrollamount="4" if="{{ singleTodo.isLongTitle }}">{{singleTodo.title}}</marquee>
                <text class="todo-title" if="{{ singleTodo.isShortTitle }}">{{singleTodo.title}}</text>
                <text class="todo-meta" if="{{ singleTodo.dueDate }}">{{singleTodo.dueDate}}</text>
              </div>
              <div class="card-right">
                <div class="priority-dot" style="background-color: {{getPriorityColor(singleTodo.priority)}};"></div>
                <text class="todo-status" if="{{ singleTodo.done }}">已完成</text>
                <text class="todo-status undone" else>待完成</text>
              </div>
            </div>
            <text class="delete-hint-text">长按删除</text>
          </div>

          <div else class="swiper-wrapper">
            <swiper class="todo-swiper" indicator="false">
              <div class="todo-card swiper-card" for="{{ todos }}" style="border-left: 6px solid {{$item.themeColor || '#3184d0'}};" onclick="toggleDone($idx)" onlongpress="deleteTodo($idx)">
                <div class="card-main">
                  <marquee class="todo-title" scrollamount="4" if="{{ $item.isLongTitle }}">{{$item.title}}</marquee>
                  <text class="todo-title" if="{{ $item.isShortTitle }}">{{$item.title}}</text>
                  <text class="todo-meta" if="{{ $item.dueDate }}">{{$item.dueDate}}</text>
                </div>
                <div class="card-right">
                  <div class="priority-dot" style="background-color: {{getPriorityColor($item.priority)}};"></div>
                  <text class="todo-status" if="{{ $item.done }}">已完成</text>
                  <text class="todo-status undone" else>待完成</text>
                </div>
              </div>
            </swiper>
          </div>
    </div>

    <div class="add-fab" onclick="addTodo">
      <text class="add-fab-text">＋ 新建</text>
    </div>
  </div>
</template>

<style>
  @import "../../common/app.css";

  .index-page {
    flex-direction: column;
    align-items: center;
    color: white;
    background-color: #000000;
  }

  .box {
    position: relative;
    flex: 1;
    width: 90%;
    margin-top: 86px;
    margin-bottom: 86px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .add-fab {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 150px;
    height: 52px;
    margin-bottom: 24px;
    border-radius: 100%;
    background-color: #262626;
    border: 3px solid rgba(255, 255, 255, 0.06);
  }

  .add-fab-text {
    color: #ffffff;
    font-size: 26px;
    font-weight: bold;
  }

  .single-wrapper {
    width: 100%;
    flex-direction: column;
    align-items: center;
  }

  .swiper-wrapper {
    width: 100%;
    flex: 1;
  }

  .todo-swiper {
    width: 100%;
    height: 100%;
  }

  .todo-card {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 100px;
    border-radius: 20px;
    overflow: hidden;
    background-color: #ffffff;
    padding: 16px 20px;
    box-sizing: border-box;
  }

  .single-card {
    min-height: 160px;
  }

  .swiper-card {
    min-height: 140px;
  }

  .card-main {
    flex: 1;
    flex-direction: column;
    justify-content: center;
    padding-right: 12px;
  }

  .todo-title {
    font-size: 28px;
    color: #000000;
    font-weight: bold;
    text-overflow: ellipsis;
    height: 36px;
    width: 100%;
  }

  .todo-meta {
    font-size: 20px;
    color: #6f6f6f;
    margin-top: 8px;
  }

  .card-right {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 80px;
  }

  .priority-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-bottom: 12px;
  }

  .todo-status {
    font-size: 18px;
    color: #4cd964;
    font-weight: bold;
  }

  .todo-status.undone {
    color: #6f6f6f;
  }

  .delete-hint-text {
    font-size: 18px;
    color: #6f6f6f;
    margin-top: 16px;
  }

  .empty-state {
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .empty-text {
    font-size: 28px;
    color: #6f6f6f;
    font-weight: bold;
  }

  .empty-hint {
    font-size: 20px;
    color: #3a3a3a;
    margin-top: 12px;
  }

  @media (device-type: band) and (shape: rect) {
    .box {
      margin-top: 92px;
      margin-bottom: 16px;
      width: 83%;
    }
  }

  @media (device-type: watch) and (shape: rect) {
    .box {
      margin-top: 102px;
      margin-bottom: 32px;
      width: 75%;
    }
  }

  @media (device-type: watch) and (shape: circle) {
    .box {
      margin-top: 92px;
      margin-bottom: 84px;
      width: 70%;
    }
  }
</style>

<script>
  import router from '@system.router'
  import file from '@system.file'
  import vibrator from '@system.vibrator'
  import prompt from '@system.prompt'
  import { getPriorityColor } from '../../common/utils.js'
  import { initSync, broadcastChanged } from '../../common/sync.js'

  const DATA_PATH = '/data/todos.json'

  export default {
    private: {
      time: '',
      todos: []
    },
    onInit() {
      this.loadTodos()
      initSync((todos) => {
        this.todos = (todos || []).map(function(t) {
          t.isLongTitle = t.title && t.title.length > 10
          t.isShortTitle = !t.isLongTitle
          return t
        })
      })
    },
    onShow() {
      this.time = global.getTime ? global.getTime() : ''
      this.loadTodos()
    },
    get singleTodo() {
      return this.todos.length === 1 ? this.todos[0] : { title: '', done: false, priority: '无', dueDate: '', themeColor: '#3184d0', isShortTitle: true, isLongTitle: false }
    },
    loadTodos() {
      let that = this
      file.readText({
        uri: 'internal://app' + DATA_PATH,
        success(ret) {
          try {
            let data = JSON.parse(ret.text)
            that.todos = (data || []).map(function(t) {
              t.isLongTitle = t.title && t.title.length > 10
              t.isShortTitle = !t.isLongTitle
              return t
            })
          }
          catch (e) {
            that.todos = []
          }
        },
        fail() {
          that.todos = []
        }
      })
    },
    saveTodos() {
      file.writeText({
        uri: 'internal://app' + DATA_PATH,
        text: JSON.stringify(this.todos),
        success() {},
        fail() {
          prompt.showToast({ message: '保存失败' })
        }
      })
    },
    getPriorityColor(p) {
      return getPriorityColor(p)
    },
    toggleDone(idx) {
      this.todos.splice(idx, 1, Object.assign({}, this.todos[idx], { done: !this.todos[idx].done }))
      this.saveTodos()
      broadcastChanged()
      vibrator.vibrate({ mode: 'short' })
    },
    deleteTodo(idx) {
      let that = this
      prompt.showDialog({
        title: '删除',
        message: '确定删除此待办？',
        buttons: [
          { text: '取消', color: '#6f6f6f' },
          { text: '删除', color: '#ff6a24' }
        ],
        success(ret) {
          if (ret.index === 1) {
            that.todos.splice(idx, 1)
            that.saveTodos()
            broadcastChanged()
          }
        }
      })
    },
    addTodo() {
      router.push({ uri: '/pages/input' })
    }
  }
</script>
