{
  "package": "com.todo.watch",
  "name": "待办清单",
  "versionName": "1.0.0",
  "versionCode": 10001,
  "minPlatformVersion": 1000,
  "icon": "/common/logo.png",
  "deviceTypeList": ["watch"],
  "features": [
    { "name": "system.router" },
    { "name": "system.app" },
    { "name": "system.prompt" },
    { "name": "system.vibrator" },
    { "name": "system.file" }
  ],
  "config": {
    "logLevel": "log",
    "designWidth": "device-width"
  },
  "router": {
    "entry": "pages/index",
    "pages": {
      "pages/index": { "component": "index" },
      "pages/input": { "component": "input" },
      "pages/datepicker": { "component": "datepicker" }
    }
  },
  "display": {
    "backgroundColor": "#000000"
  }
}
