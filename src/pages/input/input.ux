<template>
  <div class="container">
    <text class="time">{{ time }}</text>
    <text class="title" if="{{ global.screenShape == 'rect' }}">新建待办</text>
    <img
      if="{{ global.screenShape == 'rect' }}"
      class="top leftButton"
      src="/common/back_rect.png"
      @click="goBack"
    />
    <div @click="goBack" class="title circle-title" elif="{{ global.screenShape == 'circle' }}">
      <img class="icon-back" src="/common/back.png" />
      <text class="title-text">新建待办</text>
    </div>
    <img else class="top" src="/common/back.png" @click="goBack" />

    <img
      if="{{ global.screenShape == 'rect' }}"
      class="top rightButton"
      src="/common/check_rect.png"
      @click="saveTodo"
    />
    <img else class="bottom" src="/common/check.png" @click="saveTodo" />

    <div class="padding" style="height: {{kbVisible ? '320px' : '100px'}};"></div>

    <!-- 输入框（胶囊形） -->
    <div class="line">
      <div class="input-line capsule-input" @click="changeKbState">
        <text class="input-text" style="color: {{inputTextColor}};">
          {{textValue || '点击输入内容'}}
        </text>
      </div>
    </div>

    <!-- 操作栏 -->
    <div class="action-bar">
      <div class="action-btn priority-btn" onclick="goToPriority">
        <text class="action-label">优先级</text>
        <text class="priority-preview" style="color: {{getPriorityColor(selectedPriority)}};">{{priorityLabel}}</text>
      </div>
      <div class="action-btn date-btn" onclick="showDatePicker">
        <text class="action-label">日期</text>
        <text class="action-text">{{dateLabel}}</text>
      </div>
    </div>

    <!-- 主题色选择器 -->
    <div class="theme-section">
      <text class="theme-label">主题色</text>
      <div class="theme-colors">
        <div for="{{ themeColors }}" class="color-swatch" style="background-color: {{ $item.hex }}; opacity: {{ $item.hex === selectedColor ? 1.0 : 0.4 }};" onclick="selectColor($idx)"></div>
      </div>
    </div>

    <!-- 自定义键盘 -->
    <div class="keyboard" if="{{!hide}}">
      <!-- 候选词区域 -->
      <div class="candidates" if="{{candidates.length > 0}}">
        <text class="candidate" for="{{candidates}}" @click="selectCandidate($item)">{{$item}}</text>
      </div>
      <!-- 拼音输入显示 -->
      <div class="pinyin-bar" if="{{pinyin.length > 0}}">
        <text class="pinyin-text">{{pinyin}}</text>
      </div>
      <!-- 第一行: Q W E R T Y U I O P -->
      <div class="keyboard-row">
        <text class="key" @click="onKey('Q')">Q</text>
        <text class="key" @click="onKey('W')">W</text>
        <text class="key" @click="onKey('E')">E</text>
        <text class="key" @click="onKey('R')">R</text>
        <text class="key" @click="onKey('T')">T</text>
        <text class="key" @click="onKey('Y')">Y</text>
        <text class="key" @click="onKey('U')">U</text>
        <text class="key" @click="onKey('I')">I</text>
        <text class="key" @click="onKey('O')">O</text>
        <text class="key" @click="onKey('P')">P</text>
      </div>
      <!-- 第二行: A S D F G H J K L -->
      <div class="keyboard-row">
        <text class="key" @click="onKey('A')">A</text>
        <text class="key" @click="onKey('S')">S</text>
        <text class="key" @click="onKey('D')">D</text>
        <text class="key" @click="onKey('F')">F</text>
        <text class="key" @click="onKey('G')">G</text>
        <text class="key" @click="onKey('H')">H</text>
        <text class="key" @click="onKey('J')">J</text>
        <text class="key" @click="onKey('K')">K</text>
        <text class="key" @click="onKey('L')">L</text>
      </div>
      <!-- 第三行: 切换 ZXCVBNM 删除 -->
      <div class="keyboard-row">
        <text class="key lang-key" @click="toggleLang">{{langLabel}}</text>
        <text class="key" @click="onKey('Z')">Z</text>
        <text class="key" @click="onKey('X')">X</text>
        <text class="key" @click="onKey('C')">C</text>
        <text class="key" @click="onKey('V')">V</text>
        <text class="key" @click="onKey('B')">B</text>
        <text class="key" @click="onKey('N')">N</text>
        <text class="key" @click="onKey('M')">M</text>
        <text class="key del-key" @click="onDelete">⌫</text>
      </div>
      <!-- 第四行: 空格 -->
      <div class="keyboard-row">
        <text class="key space-key" @click="onSpace">空格</text>
        <text class="key enter-key" @click="hideKeyboard">完成</text>
      </div>
    </div>
  </div>
</template>

<style>
