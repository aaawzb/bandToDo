<template>
  <div class="index-page">
    <text class="time">{{ time }}</text>
    <text class="title" if="{{ global.screenShape == 'rect' }}">待办清单</text>
    <img
      if="{{ global.screenShape == 'rect' }}"
      class="top rightButton"
      src="/common/add_rect.png"
      @click="addTodo"
    />
    <text @click="addTodo" class="title" elif="{{ global.screenShape == 'circle' }}">
      <span class="iconfont">&#xe685;</span>
      <span>待办清单</span>
    </text>
    <img else class="top" src="/common/add.png" @click="addTodo" />

    <div class="box">
      <scroll scroll-y="true" bounces="true">
        <div for="{{ todos }}">
          <div class="todo-card" onclick="toggleDone($idx)">
            <div class="card-left">
              <div class="priority-dot" style="background-color: {{getPriorityColor($item.priority)}};"></div>
              <div class="card-content">
                <text class="todo-title" lines="1">{{$item.title}}</text>
                <text class="todo-meta" if="{{ $item.dueDate }}">{{$item.dueDate}}</text>
              </div>
            </div>
            <div class="card-right">
              <text class="todo-status" if="{{ $item.done }}">已完成</text>
              <text class="todo-status undone" else>待完成</text>
            </div>
          </div>
        </div>
      </scroll>
    </div>

    <div if="{{ todos.length === 0 }}" class="empty-state">
      <text class="empty-text">暂无待办事项</text>
      <text class="empty-hint">点击右上角添加</text>
    </div>

    <img
      if="{{ global.screenShape == 'rect' }}"
      class="bottom rightButton"
      src="/common/del_rect.png"
      @click="deleteMode"
    />
    <img else class="bottom" src="/common/del.png" @click="deleteMode" />
  </div>
</template>

<style>
  @import "../../common/app.css";

  .index-page {
    flex-direction: column;
    align-items: center;
    color: white;
    background-color: black;
  }

  .box {
    position: relative;
    flex: 1;
    width: 90%;
    margin-top: 86px;
    margin-bottom: 86px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  scroll {
    flex: 1;
    width: 100%;
    align-items: flex-start;
    flex-direction: column;
  }

  .todo-card {
    display: flex;
    flex-direction: row;
    align-items: center;
    width: 100%;
    height: 78px;
    border-radius: 14px;
    margin-bottom: 10px;
    overflow: hidden;
    background-color: #262626;
    border: 3px solid rgba(255, 255, 255, 0.06);
  }

  .card-left {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex: 1;
    height: 100%;
    padding-left: 12px;
  }

  .priority-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 10px;
  }

  .card-content {
    flex: 1;
    flex-direction: column;
  }

  .todo-title {
    font-size: 26px;
    color: white;
    font-weight: bold;
    text-overflow: ellipsis;
    lines: 1;
  }

  .todo-meta {
    font-size: 18px;
    color: #6f6f6f;
    margin-top: 4px;
  }

  .card-right {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 25%;
    height: 100%;
  }

  .todo-status {
    font-size: 18px;
    color: #4cd964;
    font-weight: bold;
  }

  .todo-status.undone {
    color: #6f6f6f;
  }

  .empty-state {
    position: absolute;
    top: 40%;
    flex-direction: column;
    align-items: center;
  }

  .empty-text {
    font-size: 28px;
    color: #6f6f6f;
    font-weight: bold;
  }

  .empty-hint {
    font-size: 20px;
    color: #3a3a3a;
    margin-top: 12px;
  }

  @media (device-type: band) and (shape: rect) {
    .box {
      margin-top: 92px;
      margin-bottom: 16px;
      width: 83%;
    }
  }

  @media (device-type: watch) and (shape: rect) {
    .box {
      margin-top: 102px;
      margin-bottom: 32px;
      width: 75%;
    }
  }

  @media (device-type: watch) and (shape: circle) {
    .box {
      margin-top: 92px;
      margin-bottom: 84px;
      width: 70%;
    }
  }
</style>

<script>
  import router from '@system.router'
  import file from '@system.file'
  import vibrator from '@system.vibrator'
  import prompt from '@system.prompt'
  import { getPriorityColor } from '../../common/utils.js'

  const DATA_PATH = '/data/todos.json'

  export default {
    private: {
      time: '',
      todos: [],
      deleteModeActive: false
    },
    onInit() {
      this.loadTodos()
    },
    onShow() {
      this.time = global.getTime ? global.getTime() : ''
      this.loadTodos()
    },
    loadTodos() {
      let that = this
      file.readText({
        uri: 'internal://app' + DATA_PATH,
        success(ret) {
          try {
            let data = JSON.parse(ret.text)
            that.todos = data || []
          }
          catch (e) {
            that.todos = []
          }
        },
        fail() {
          that.todos = []
        }
      })
    },
    saveTodos() {
      file.writeText({
        uri: 'internal://app' + DATA_PATH,
        text: JSON.stringify(this.todos),
        success() {},
        fail() {
          prompt.showToast({ message: '保存失败' })
        }
      })
    },
    getPriorityColor(p) {
      return getPriorityColor(p)
    },
    toggleDone(idx) {
      this.todos.splice(idx, 1, Object.assign({}, this.todos[idx], { done: !this.todos[idx].done }))
      this.saveTodos()
      vibrator.vibrate({ mode: 'short' })
    },
    deleteTodo(idx) {
      let that = this
      prompt.showDialog({
        title: '删除',
        message: '确定删除此待办？',
        buttons: [
          { text: '取消', color: '#6f6f6f' },
          { text: '删除', color: '#ff6a24' }
        ],
        success(ret) {
          if (ret.index === 1) {
            that.todos.splice(idx, 1)
            that.saveTodos()
          }
        }
      })
    },
    deleteMode() {
      if (this.todos.length === 0) return
      let that = this
      prompt.showDialog({
        title: '删除模式',
        message: '点击要删除的待办项',
        buttons: [{ text: '确定', color: '#ff6a24' }],
        success() {
          that.deleteModeActive = !that.deleteModeActive
        }
      })
    },
    addTodo() {
      router.push({ uri: '/pages/input' })
    }
  }
</script>
